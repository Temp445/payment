datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum OrderStatus {
  CREATED
  ACTIVE
  PAID
  FAILED
  EXPIRED
  CANCELLED
  PARTIALLY_REFUNDED
  REFUNDED
}

enum PaymentStatus {
  SUCCESS
  FAILED
  PENDING
  USER_DROPPED
  CANCELLED
}

enum RefundStatus {
  PENDING
  SUCCESS
  FAILED
}

enum WebhookStatus {
  PENDING
  PROCESSING
  DELIVERED
  FAILED
}

model Application {
  id               String       @id @default(uuid())
  appCode          String       @unique // e.g. 'APP001', 'WEBSITE_01', 'ANDROID_STORE'
  appName          String
  clientId         String       @unique
  clientSecretHash String
  webhookUrl       String?
  webhookSecret    String
  isActive         Boolean      @default(true)
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt

  orders           Order[]
  auditLogs        AuditLog[]
  outboxDeliveries WebhookOutboxQueue[]
  productOffers    ProductOffer[]

  @@map("applications")
}

model Order {
  id               String       @id @default(uuid())
  applicationId    String
  application      Application  @relation(fields: [applicationId], references: [id], onDelete: Restrict)
  appOrderId       String       // Client's order reference
  cfOrderId        String       @unique // Namespaced: ${appCode}_${appOrderId}
  paymentSessionId String?
  orderAmount      Decimal      @db.Decimal(12, 2)
  orderCurrency    String       @default("INR")
  orderStatus      OrderStatus  @default(CREATED)
  customerId       String
  customerName     String?
  customerEmail    String?
  customerPhone    String
  orderNote        String?
  returnUrl        String?
  notifyUrl        String?
  metadata         Json?        @default("{}")
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt

  payments         Payment[]
  refunds          Refund[]
  outboxDeliveries WebhookOutboxQueue[]

  @@unique([applicationId, appOrderId])
  @@index([applicationId])
  @@index([cfOrderId])
  @@index([orderStatus])
  @@map("orders")
}

model Payment {
  id                String        @id @default(uuid())
  orderId           String
  order             Order         @relation(fields: [orderId], references: [id], onDelete: Cascade)
  cfPaymentId       String        @unique
  paymentAmount     Decimal       @db.Decimal(12, 2)
  paymentCurrency   String        @default("INR")
  paymentStatus     PaymentStatus
  paymentMethod     String?       // 'upi', 'card', 'netbanking'
  paymentGroup      String?
  paymentTime       DateTime?
  bankReference     String?
  authId            String?
  errorCode         String?
  errorDescription  String?
  rawWebhookPayload Json?
  createdAt         DateTime      @default(now())

  @@index([orderId])
  @@map("payments")
}

model Refund {
  id             String       @id @default(uuid())
  orderId        String
  order          Order        @relation(fields: [orderId], references: [id], onDelete: Restrict)
  cfRefundId     String?      @unique
  refundAmount   Decimal      @db.Decimal(12, 2)
  refundCurrency String       @default("INR")
  refundNote     String?
  refundStatus   RefundStatus @default(PENDING)
  refundType     String       @default("STANDARD")
  rawResponse    Json?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@index([orderId])
  @@map("refunds")
}

model Settlement {
  id                 String    @id @default(uuid())
  cfSettlementId     String    @unique
  settlementAmount   Decimal   @db.Decimal(12, 2)
  settlementCurrency String    @default("INR")
  utrNumber          String?
  settlementDate     DateTime
  status             String
  rawPayload         Json?
  createdAt          DateTime  @default(now())

  @@map("settlements")
}

model WebhookOutboxQueue {
  id            String        @id @default(uuid())
  applicationId String
  application   Application   @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  orderId       String?
  order         Order?        @relation(fields: [orderId], references: [id], onDelete: Cascade)
  eventType     String        // e.g. 'PAYMENT.SUCCESS'
  payload       Json
  status        WebhookStatus @default(PENDING)
  attempts      Int           @default(0)
  maxAttempts   Int           @default(5)
  nextRetryAt   DateTime      @default(now())
  responseStatus Int?
  lastError     String?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  @@index([status, nextRetryAt])
  @@map("webhook_outbox_queue")
}

model AuditLog {
  id             String       @id @default(uuid())
  applicationId  String?
  application    Application? @relation(fields: [applicationId], references: [id], onDelete: SetNull)
  action         String
  entityType     String?
  entityId       String?
  ipAddress      String?
  requestDetails Json?
  createdAt      DateTime     @default(now())

  @@map("audit_logs")
}

model PaymentHubConfig {
  key       String   @id @db.VarChar(50)
  value     String   @db.Text
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at")

  @@map("payment_hub_config")
}

model ProductOffer {
  id              String               @id @default(uuid()) @db.Uuid
  applicationId   String               @map("application_id")
  application     Application          @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  productCode     String               @map("product_code")
  productName     String               @map("product_name")
  availableFrom   DateTime             @default(now()) @map("available_from") @db.Date
  productIsActive Boolean              @default(true) @map("product_is_active")
  createdAt       DateTime             @default(now()) @map("created_at") @db.Timestamptz
  updatedAt       DateTime             @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  subscriptionOffers  SubscriptionOffer[]
  userSubscriptions   UserSubscription[]
  paymentTransactions PaymentTransaction[]

  @@unique([applicationId, productCode])
  @@map("products_offers")
}

model SubscriptionOffer {
  id              BigInt               @id @default(autoincrement())
  productId       String               @map("product_id") @db.Uuid
  product         ProductOffer         @relation(fields: [productId], references: [id], onDelete: Cascade)
  tier            String
  tierLevel       Int                  @default(1) @map("tier_level")
  offerPrice      Float                @default(0) @map("offer_price")
  offerCurrency   String               @default("INR") @map("offer_currency")
  offerPeriod     Int                  @default(1) @map("offer_period")
  offerPeriodType String               @default("month") @map("offer_period_type")
  userLimit       Int                  @default(5) @map("user_limit")
  tierLimits      Json?                @default("{\"features\": []}") @map("tier_limits")
  offerIsActive   Boolean              @default(true) @map("offer_is_active")
  createdAt       DateTime             @default(now()) @map("created_at") @db.Timestamptz
  updatedAt       DateTime             @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  userSubscriptions   UserSubscription[]
  paymentTransactions PaymentTransaction[]

  @@map("subscription_offers")
}

model UserSubscription {
  id              BigInt            @id @default(autoincrement())
  productId       String            @map("product_id") @db.Uuid
  product         ProductOffer      @relation(fields: [productId], references: [id], onDelete: Cascade)
  offerId         BigInt            @map("offer_id")
  offer           SubscriptionOffer @relation(fields: [offerId], references: [id], onDelete: Cascade)
  offerStartsOn   DateTime          @default(now()) @map("offer_starts_on") @db.Date
  offerEndsOn     DateTime          @map("offer_ends_on") @db.Date
  offerIsActive   Boolean           @default(true) @map("offer_is_active")
  organizationId  String            @map("organization_id")
  userId          String            @map("user_id")
  isTrialPeriod   Boolean           @default(false) @map("is_trial_period")
  createdAt       DateTime          @default(now()) @map("created_at") @db.Timestamptz
  updatedAt       DateTime          @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  @@unique([organizationId, productId])
  @@map("user_subscriptions")
}

model PaymentTransaction {
  id               String            @id @default(uuid()) @db.Uuid
  gatewayPaymentId String?           @map("gateway_payment_id")
  gatewayOrderId   String?           @map("gateway_order_id")
  gatewaySignature String?           @map("gateway_signature")
  gatewayName      String?           @default("CASHFREE") @map("gateway_name")
  amount           Decimal           @db.Decimal
  currency         String            @default("INR")
  status           String            @default("PAID")
  receiptNumber    String            @map("receipt_number")
  productId        String            @map("product_id") @db.Uuid
  product          ProductOffer      @relation(fields: [productId], references: [id], onDelete: Cascade)
  offerId          BigInt            @map("offer_id")
  offer            SubscriptionOffer @relation(fields: [offerId], references: [id], onDelete: Cascade)
  offerPeriod      Int               @default(1) @map("offer_period")
  offerPeriodType  String            @default("month") @map("offer_period_type")
  organizationId   String            @map("organization_id")
  userId           String?           @map("user_id")
  createdAt        DateTime          @default(now()) @map("created_at") @db.Timestamptz
  updatedAt        DateTime          @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  @@map("payment_transactions")
}


