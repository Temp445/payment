# ==========================================
# Payment Hub Configuration
# ==========================================

# Public URL of the Payment Hub (Used for Webhook routing)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Supabase PostgreSQL Connection Strings
# DATABASE_URL: Supavisor Transaction Pooler (Port 6543)
DATABASE_URL="postgresql://postgres.[YOUR-PROJECT-REF]:[YOUR-PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=15"

# DIRECT_URL: Direct Database Connection (Port 5432) used for Prisma Migrations
DIRECT_URL="postgresql://postgres:[YOUR-PASSWORD]@db.[YOUR-PROJECT-REF].supabase.co:5432/postgres"

# Cashfree Payment Gateway Credentials
# Environment: TEST (Sandbox) or PRODUCTION
CASHFREE_ENV=TEST
CASHFREE_APP_ID=your-cashfree-app-id
CASHFREE_SECRET_KEY=your-cashfree-secret-key
CASHFREE_API_VERSION=2023-08-01

# Master Admin API Key (For Next.js Admin Dashboard and internal operations)
ADMIN_API_KEY=admin_secret_hub_master_key_change_me

# Outbox Worker Configuration (Redis-Free)
OUTBOX_MAX_RETRIES=5
OUTBOX_BATCH_SIZE=20
OUTBOX_TIMEOUT_MS=4000

